programa {
  funcao inicio() {

    /*Como SOMAR palavras */

    cadeia letras1, letras2, teste1

    escreva("Digite seu nome: \n")
    leia(letras1)
    escreva("Digite seu sobrenome: \n")
    leia(letras2)

    teste1 = letras1 + " " + letras2

    escreva("Seu nome completo é: \n",teste1,"!")
  }
}
