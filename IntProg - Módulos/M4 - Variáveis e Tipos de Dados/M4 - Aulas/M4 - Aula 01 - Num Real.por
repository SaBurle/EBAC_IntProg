programa {
  funcao inicio() {

    real num1, num2, teste1, teste2

    escreva("Digite dois valores: \n")
    leia(num1,num2)

    teste1 = num1 + num2
    teste2 = num1 / num2

    escreva("O primeiro número é: ",num1," \n")
    escreva("O segundo número é: ",num2,"\n")
    escreva("A soma deles é: ",teste1,"\n")
    escreva("A divisão do primeiro pelo segundo é: ",teste2,"\n")
    
  }
}
